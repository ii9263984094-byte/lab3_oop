        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class EventBookingError {\n        +Exception\n    }\n    class InvalidPriceError {\n    }\n    class SeatAlreadyBookedError {\n    }\n    class EventNotFoundError {\n    }\n    class DataFormatError {\n    }\n\n    EventBookingError &lt;|-- InvalidPriceError\n    EventBookingError &lt;|-- SeatAlreadyBookedError\n    EventBookingError &lt;|-- EventNotFoundError\n    EventBookingError &lt;|-- DataFormatError\n\n    class Event {\n        &lt;&lt;abstract&gt;&gt;\n        +int event_id\n        #str title\n        #float base_price\n        +get_info()* str\n        +to_dict() dict\n    }\n\n    class Concert {\n        +str performer\n        +get_info() str\n        +to_dict() dict\n    }\n\n    class TheaterPlay {\n        +str director\n        +get_info() str\n        +to_dict() dict\n    }\n\n    class Conference {\n        +str topic\n        +get_info() str\n        +to_dict() dict\n    }\n\n    Event &lt;|-- Concert\n    Event &lt;|-- TheaterPlay\n    Event &lt;|-- Conference\n\n    class Venue {\n        +int venue_id\n        +str name\n        +str address\n        +to_xml() Element\n        +from_xml(elem) Venue\n    }\n\n    class Seat {\n        +int row\n        +int number\n        +bool is_booked\n    }\n\n    class User {\n        +int user_id\n        +str name\n        +str email\n    }\n\n    class Ticket {\n        +int ticket_id\n        +Event event\n        +Seat seat\n    }\n\n    class Booking {\n        +int booking_id\n        +User user\n        +Ticket ticket\n    }\n\n    class Payment {\n        +int payment_id\n        +float amount\n        +str status\n    }\n\n    class BookingSystem {\n        +list~Event~ events\n        +list~Venue~ venues\n        +create_event(event)\n        +read_events() list\n        +update_event_price(event_id, new_price)\n        +delete_event(event_id)\n        +save_events_json(filepath)\n        +load_events_json(filepath)\n        +save_venues_xml(filepath)\n        +load_venues_xml(filepath)\n    }\n\n    BookingSystem o-- Event\n    BookingSystem o-- Venue\n    Ticket --&gt; Event\n    Ticket --&gt; Seat\n    Booking *-- Ticket\n    Booking --&gt; User&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tC7mlVM6lrpSm1v8gO0G-1">
